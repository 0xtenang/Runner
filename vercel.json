{
  "rewrites": [
    {
      "source": "/redirect",
      "destination": "/redirect.html"
    },
    {
      "source": "/whitepaper",
      "destination": "/whitepaper.html"
    },
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/nft/image/:id",
      "destination": "/api/nft-image?id=:id"
    },
    {
      "source": "/nft/:id((?!collection\\.json$)[^/]+)",
      "destination": "/api/nft?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"runner.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/downloads/android.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
